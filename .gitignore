# Android (Gradle) build artifacts — mirrors dist/release/ above, same
# reasoning: generated on every build, never something to diff/review.
android/android/**/build/
android/android/.gradle/
android/android/local.properties
android/android/**/*.iml
android/android/.idea/
android/android/captures/
android/android/app/release/
android/android/app/debug/

# Android release signing — real credentials never committed (same policy
# as desktop/'s CSC_LINK/CSC_KEY_PASSWORD), see keystore.properties.example.
android/android/keystore.properties
android/android/*.jks
android/android/*.keystore

