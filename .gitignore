node_modules/
dist/
release/
update-staging/
.env
.env.*
.env.test.local
*.log
".env"
"*.log"
"node_modules/"
sql/all_databases.sql
*.pdf
sbom.cdx.json
graphify-out/
accepted-releases/
backend/data/geoip/

# Android (Gradle) build artifacts — mirrors dist/release/ above, same
# reasoning: generated on every build, never something to diff/review.
android/android/**/build/
android/android/.gradle/
android/android/local.properties
android/android/**/*.iml
android/android/.idea/
android/android/captures/
android/android/app/release/
android/android/app/debug/

# Android release signing — real credentials never committed (same policy
# as desktop/'s CSC_LINK/CSC_KEY_PASSWORD), see keystore.properties.example.
android/android/keystore.properties
android/android/*.jks
android/android/*.keystore

# iOS (Xcode) build artifacts — same reasoning as the Android block above.
android/ios/App/build/
android/ios/App/Pods/
android/ios/App/App.xcworkspace/xcuserdata/
android/ios/App/App.xcodeproj/xcuserdata/
android/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
android/ios/DerivedData/

# iOS release signing — same policy as Android's keystore.properties above:
# real distribution certificates/provisioning profiles never committed.
android/ios/App/*.p12
android/ios/App/*.mobileprovision
android/ios/ExportOptions.plist

